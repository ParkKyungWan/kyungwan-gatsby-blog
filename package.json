  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatsbyjs/gatsby-starter-blog.git"
  },
  "scripts": {
    "build": "gatsby build",
    "dev": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint --ext .tsx --ext .ts .",
    "prebuild": "npm run content:check && npm run stickers:prepare && npm run posts:prepare",
    "predev": "npm run content:check && npm run stickers:prepare && npm run posts:prepare",
    "dev:drafts": "npm run content:check && npm run stickers:prepare && BLOG_PREVIEW_DRAFTS=true gatsby develop",
    "content:check": "node scripts/content.cjs",
    "post:new": "node scripts/new-post.cjs",
    "image:add": "node scripts/add-image.cjs",
    "typecheck": "tsc --noEmit",
    "stickers:prepare": "node scripts/sticker-metadata.cjs",
    "posts:prepare": "node scripts/prepare-published.cjs",
    "pretest": "npm run posts:prepare"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "sharp": "$sharp"
  }
}
